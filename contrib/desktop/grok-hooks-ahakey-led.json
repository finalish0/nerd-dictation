{
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse done'",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse ask'",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse ask'",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse off'",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse send'",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "sh -c '$HOME/.local/bin/nerd-dictation-toggle suspend'",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/git/ahakey-x1/ahakey.sh pulse error'",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
