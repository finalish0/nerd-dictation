#!/bin/sh
# Toggle / suspend / stop the warm nerd-dictation user service.
# Master switch: on | off  (no Sway edits). Mic is a no-op while off.
# Optional: AhaKey LED via $AHAKEY (pulse breathing | off).
set -eu

ND="${ND:-$HOME/git/nerd-dictation/nerd-dictation}"
AHAKEY="${AHAKEY:-$HOME/git/ahakey-x1/ahakey.sh}"
SERVICE=nerd-dictation.service
LOG="${LOG:-$HOME/.local/state/nerd-dictation.log}"
FLAGDIR="${FLAGDIR:-$HOME/.config/nerd-dictation}"
FLAG="$FLAGDIR/disabled"
PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nerd-dictation.pid"
SWAYBIND="${SWAYBIND:-$HOME/.config/sway/nerd-dictation.conf}"
TOGGLE_BIN="${TOGGLE_BIN:-$HOME/.local/bin/nerd-dictation-toggle}"
BIND_CMD="bindsym Ctrl+Space exec --no-startup-id $TOGGLE_BIN"

mkdir -p "$(dirname "$LOG")" "$FLAGDIR" "$(dirname "$SWAYBIND")"

pulse() {
  if [ -x "$AHAKEY" ]; then
    "$AHAKEY" pulse "$1" || true
  fi
}

mainpid() { systemctl --user show "$SERVICE" -p MainPID --value 2>/dev/null; }

bind_mic() {
  printf '%s\n' \
    '# Written by nerd-dictation-toggle on/off. Do not edit by hand.' \
    "$BIND_CMD" > "$SWAYBIND"
  swaymsg -q "$BIND_CMD" 2>>"$LOG" || true
}

unbind_mic() {
  printf '%s\n' \
    '# nerd-dictation master off — Ctrl+Space is free for Grok voice etc.' > "$SWAYBIND"
  swaymsg -q 'unbindsym Ctrl+Space' 2>>"$LOG" || true
}

master_off() {
  date -Iseconds > "$FLAG"
  systemctl --user disable --now "$SERVICE" 2>>"$LOG" || true
  unbind_mic
  pulse off
  echo "nerd-dictation: off (Ctrl+Space goes to the app, e.g. Grok voice)"
}

master_on() {
  rm -f "$FLAG"
  systemctl --user enable --now "$SERVICE" >>"$LOG" 2>&1 || true
  bind_mic
  pulse off
  echo "nerd-dictation: on (Ctrl+Space is the mic; wait ~10s for the model)"
}

case "${1:-}" in
  off|disable)
    master_off
    exit 0
    ;;
  on|enable)
    master_on
    exit 0
    ;;
  status)
    if [ -f "$FLAG" ]; then
      echo "master: off"
    else
      echo "master: on"
    fi
    systemctl --user is-enabled "$SERVICE" 2>/dev/null || true
    systemctl --user is-active "$SERVICE" 2>/dev/null || true
    pid=$(mainpid)
    if [ -n "$pid" ] && [ "$pid" != "0" ]; then
      echo "pid: $pid  state: $(ps -o stat= -p "$pid" 2>/dev/null || echo gone)"
    else
      echo "pid: none"
    fi
    exit 0
    ;;
  stop)
    systemctl --user stop "$SERVICE" 2>>"$LOG" || true
    pulse off
    exit 0
    ;;
  suspend)
    pid=$(mainpid)
    if [ -z "$pid" ] || [ "$pid" = "0" ]; then
      pulse off
      exit 0
    fi
    echo "$pid" > "$PIDFILE" 2>/dev/null || true
    st=$(ps -o stat= -p "$pid" 2>/dev/null || true)
    et=$(ps -o etimes= -p "$pid" 2>/dev/null || echo 999)
    et=${et%% *}
    case "$st" in
      *T*) pulse off; exit 0 ;;
      *R*)
        if [ "${et:-0}" -lt 15 ]; then
          pulse off
          exit 0
        fi
        ;;
    esac
    kill -STOP "$pid" 2>/dev/null || exit 0
    sleep 0.05
    kill -USR1 "$pid" 2>/dev/null || true
    sleep 0.05
    kill -CONT "$pid" 2>/dev/null || true
    pulse off
    exit 0
    ;;
esac

if [ -f "$FLAG" ]; then
  pulse off
  exit 0
fi

pid=$(mainpid)

if [ -z "$pid" ] || [ "$pid" = "0" ]; then
  systemctl --user start "$SERVICE" >>"$LOG" 2>&1
  pid=$(mainpid)
fi

echo "$pid" > "$PIDFILE" 2>/dev/null || true

i=0
while :; do
  st=$(ps -o stat= -p "$pid" 2>/dev/null || true)
  case "$st" in
    *R*)
      i=$((i + 1))
      if [ "$i" -gt 60 ]; then pulse off; exit 0; fi
      sleep 0.5
      continue
      ;;
    *) break ;;
  esac
done

freeze_suspend() {
  kill -STOP "$pid" 2>/dev/null || return 0
  sleep 0.05
  kill -USR1 "$pid" 2>/dev/null || true
  sleep 0.05
  kill -CONT "$pid" 2>/dev/null || true
}

case "$st" in
  *T*)
    "$ND" resume 2>>"$LOG" || true
    pulse breathing
    ;;
  *)
    freeze_suspend
    pulse off
    ;;
esac
