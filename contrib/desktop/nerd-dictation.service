[Unit]
Description=nerd-dictation warm daemon (model preloaded, suspended, mic closed)

[Service]
Environment=NERD_DICTATION_WHISPER_LANG=de
ExecStart=%h/git/nerd-dictation/.venv/bin/python %h/git/nerd-dictation/nerd-dictation begin --vosk-model-dir=%h/.local/share/vosk-models/vosk-model-small-de-0.15 --vosk-en-model-dir=%h/.local/share/vosk-models/vosk-model-small-en-us-0.15 --whisper-model=%h/.cache/opencode-voice/models/ggml-small.bin --whisper-threads=8 --simulate-input-tool=WTYPE --input=PAREC --sample-rate=16000 --continuous --suspend-on-start
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
